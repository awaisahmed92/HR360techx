# Serve the Flutter web build (SPA).
# Coolify / Caddy picks this up from the repo root on deploy.
:80 {
	root * /srv
	encode gzip zstd
	# Real assets first; fall back to index.html for client routes
	try_files {path} /index.html
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
